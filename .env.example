# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication
JWT_SECRET=your-secret-key-change-this-in-production
NEXTAUTH_SECRET=your-nextauth-secret-change-this
NEXTAUTH_URL=http://localhost:3000

# SSO Configuration (Configure your SSO provider)
# SAML_ENTRY_POINT=https://your-sso-provider.com/sso
# SAML_ISSUER=your-app-issuer
# SAML_CERT=your-certificate

# OAuth2 / OIDC (Alternative SSO method)
# SSO_CLIENT_ID=your-client-id
# SSO_CLIENT_SECRET=your-client-secret
# SSO_ISSUER=https://your-sso-provider.com

# Database
DATABASE_PATH=./data/marketplace.db

# SAP SuccessFactors Integration
SF_API_URL=https://api.successfactors.com/odata/v2
SF_COMPANY_ID=your-company-id
SF_USERNAME=your-sf-username
SF_PASSWORD=your-sf-password

# SAP SuccessFactors OAuth (Recommended)
SF_OAUTH_URL=https://api.successfactors.com/oauth
SF_CLIENT_ID=your-client-id
SF_CLIENT_SECRET=your-client-secret

# Sync Configuration
SF_AUTO_SYNC_ENABLED=true
SF_SYNC_INTERVAL_HOURS=24
