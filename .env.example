# ==============================================
# PerformPro - Environment Configuration
# ==============================================

# ======================
# Application Settings
# ======================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PerformPro
NODE_ENV=development

# ======================
# Authentication & Security
# ======================
# CRITICAL: Change these in production to strong, unique secrets
# Generate secure secrets with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-this-in-production-use-openssl-rand
SESSION_SECRET=your-session-secret-change-this-in-production-use-openssl-rand

# Session configuration
SESSION_MAX_AGE=86400000
# 24 hours in milliseconds

# ======================
# Database Configuration
# ======================
# Development: SQLite (default)
DATABASE_PATH=./data/marketplace.db

# Production: PostgreSQL (recommended for 14K+ users)
# Uncomment and configure for production:
# DATABASE_URL=postgresql://username:password@host:5432/performpro?sslmode=require
# DATABASE_SSL=true
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=20
# DATABASE_CONNECTION_TIMEOUT=30000

# ======================
# Optional: SAP SuccessFactors Integration
# ======================
# Only configure if you're integrating with SAP SuccessFactors
# SF_API_URL=https://api.successfactors.com/odata/v2
# SF_COMPANY_ID=your-company-id
# SF_CLIENT_ID=your-oauth-client-id
# SF_CLIENT_SECRET=your-oauth-client-secret
# SF_OAUTH_URL=https://api.successfactors.com/oauth/token
# SF_AUTO_SYNC_ENABLED=false
# SF_SYNC_INTERVAL_HOURS=24

# ======================
# Email Configuration (Optional)
# ======================
# For sending review reminders, feedback notifications, etc.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=your-email@company.com
# SMTP_PASS=your-app-specific-password
# EMAIL_FROM=noreply@yourcompany.com
# EMAIL_FROM_NAME=PerformPro

# ======================
# Monitoring & Error Tracking (Production)
# ======================
# Sentry for error tracking
# SENTRY_DSN=https://your-sentry-project-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging
# LOG_LEVEL=info
# ENABLE_REQUEST_LOGGING=true
# LOG_FILE_PATH=./logs/app.log

# ======================
# Performance & Caching (Production)
# ======================
# ENABLE_REDIS_CACHE=true
# REDIS_URL=redis://localhost:6379
# CACHE_TTL_SECONDS=3600

# ======================
# Feature Flags
# ======================
# Enable/disable specific features
ENABLE_360_REVIEWS=true
ENABLE_CALIBRATION=true
ENABLE_SUCCESSION_PLANNING=true
ENABLE_ENGAGEMENT_SURVEYS=true
ENABLE_AI_INSIGHTS=true
ENABLE_FLIGHT_RISK_PREDICTION=true

# ======================
# Rate Limiting (Production)
# ======================
# Protect against abuse
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
# 100 requests per minute per IP

# ======================
# CORS Configuration (Production)
# ======================
# Comma-separated list of allowed origins
# ALLOWED_ORIGINS=https://yourcompany.com,https://app.yourcompany.com
# CORS_CREDENTIALS=true

# ======================
# File Upload (Optional)
# ======================
# For profile pictures, review attachments, etc.
# MAX_FILE_SIZE=10485760
# 10MB in bytes
# ALLOWED_FILE_TYPES=pdf,doc,docx,png,jpg,jpeg
# UPLOAD_DIR=./uploads

# ======================
# Analytics & Metrics (Optional)
# ======================
# Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Internal analytics
# ENABLE_ANALYTICS=true
# ANALYTICS_ENDPOINT=/api/analytics

# ======================
# Backup & Data Retention
# ======================
# AUTO_BACKUP_ENABLED=true
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_DAYS=30
# BACKUP_PATH=./backups

# ======================
# Security Headers (Production)
# ======================
# ENABLE_SECURITY_HEADERS=true
# CSP_REPORT_URI=/api/csp-report
# HSTS_MAX_AGE=31536000

# ======================
# Development Only
# ======================
# Skip authentication (NEVER use in production)
# DEV_SKIP_AUTH=false
# ENABLE_DEBUG_MODE=false
